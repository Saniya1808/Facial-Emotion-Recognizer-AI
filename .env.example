# Environment Configuration - Facial Emotion Recognizer AI
# Copy this file to .env for local overrides

# Backend Settings
APP_NAME="Facial Emotion Recognizer AI"
APP_VERSION="0.2.0"
ENVIRONMENT="development"
DEBUG=False
FRONTEND_ORIGIN="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000"
DATABASE_URL="sqlite:///./emotion_recognizer.db"
MAX_UPLOAD_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_SEC=120
VIDEO_SAMPLE_INTERVAL_SEC=1.0
LOG_LEVEL="INFO"

# Frontend Settings (Vite)
VITE_API_BASE_URL="http://localhost:8000"
